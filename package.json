{
  "name": "hydrocalc",
  "version": "2.0.0",
  "description": "Soil preferential flow image analysis",
  "author": "lnk137",
  "private": true,
  "main": "electron/main.cjs",
  "workspaces": [
    "HC-FrontEnd"
  ],
  "scripts": {
    "dev": "electron . --dev",
    "start": "electron .",
    "build:ui": "npm run build --workspace @hydrocalc/ui",
    "build:native": "node scripts/build-native.cjs",
    "build:windows-worker": "node scripts/build-windows.cjs",
    "make:windows": "node scripts/make-windows.cjs",
    "test": "node --test tests/*.test.cjs",
    "package": "npm run build:ui && npm run build:native && electron-forge package",
    "make": "npm run build:ui && npm run build:native && electron-forge make",
    "test:desktop": "node tests/desktop.e2e.cjs"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-dmg": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@playwright/test": "1.65.1",
    "electron": "45.3.3",
    "prettier": "^3.6.2",
    "resedit": "2.0.3"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "busboy": "1.6.0",
    "electron-squirrel-startup": "1.0.1",
    "exceljs": "4.4.0",
    "fflate": "0.8.3"
  },
  "config": {
    "forge": "./forge.config.cjs"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "fs-xattr@0.3.1": true,
    "fsevents@2.3.3": true,
    "macos-alias@0.2.12": true
  }
}
